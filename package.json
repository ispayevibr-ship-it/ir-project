{
  "name": "ir-project",
  "version": "1.0.14",
  "description": "IR Project",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.irproject.app",
    "productName": "IR Project",
    "artifactName": "IR-Project-Setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "src/**/*", "package.json"],
    "win": {"target": "nsis"},
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": "store-asar"
    },
    "publish": {"provider": "github", "owner": "ispayevibr-ship-it", "repo": "ir-project"}
  }
}
