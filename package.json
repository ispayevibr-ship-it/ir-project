{
  "name": "ir-project",
  "version": "1.0.0",
  "description": "IR Project",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.irproject.app",
    "productName": "IR Project",
    "files": ["main.js", "preload.js", "src/**/*", "package.json"],
    "win": {"target": "nsis"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true},
    "publish": {"provider": "github", "owner": "ispayevibr-ship-it", "repo": "ir-project"}
  }
}
