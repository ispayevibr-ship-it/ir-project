{
  "name": "ir-project",
  "version": "1.5.89",
  "description": "IR Project",
  "main": "main.js",
  "scripts": {"start":"electron .","build":"electron-builder --win nsis","publish":"electron-builder --win nsis --publish always"},
  "dependencies": {"xlsx":"^0.18.5"},
  "devDependencies": {"electron":"38.1.2","electron-builder":"26.17.0"},
  "build": {
    "appId":"com.irproject.app",
    "productName":"IR Project",
    "asar":true,
    "artifactName":"IR-Project-Setup-${version}.${ext}",
    "files":["main.js","preload.js","src/**/*","assets/**/*","package.json"],
    "win":{"target":"nsis","icon":"assets/icon.ico"},
    "nsis":{"oneClick":true,"perMachine":false,"allowElevation":true,"deleteAppDataOnUninstall":false}
  }
}
